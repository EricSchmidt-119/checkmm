#!/bin/bash

exename=$1

result=0

# Files that should pass the verifier
cd pass || exit -1
for mmfile in *.mm; do
    if ../../"$exename" "$mmfile"; then
        echo "$exename pass/$mmfile: succeeded"
    else
        echo "$exename pass/$mmfile: failed"
        result=-1
    fi
done

# Files that should not pass the verifier
cd ../fail || exit -1
for mmfile in *.mm; do
    ../../"$exename" "$mmfile" 2>/dev/null
    testresult=$?
    if [[ $testresult -ne 255 ]] ; then
        echo "$exename fail/$mmfile: failed"
        result=-1
    else
        echo "$exename fail/$mmfile: succeeded"
    fi
done

exit "$result"
